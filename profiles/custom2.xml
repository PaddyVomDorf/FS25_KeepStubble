<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!--
	Für jede Fruchtart einzeln einstellbar:
	
    - densityReductionPercent: wie viel Prozent der Foliage entfernt wird
	
    - targetFoliageState: 
	"-1"/"cut" = automatischer Vanilla Stoppelzustand
    "0" = wie Original komplett entfernen, 
	"1".."16" = feste Wachstumsstufe erzwingen (wird pro Frucht automatisch auf deren echtes Maximum begrenzt)

    Eigene/fehlende Fruchtarten kannst du einfach als weiteren <fruit>-
    Eintrag hinzufuegen (name = exakter Fruchttyp-Name, z.B. ALFALFA). 
	Fruchtarten, die hier nicht eingetragen sind, nutzen automatisch die <default>-Werte ganz unten.
	
	Den Namen des Profils bitte NUR hier ändern, nicht die Datei umbenennen!
-->
<settings name="Custom">
    <fruit name="WHEAT" densityReductionPercent="3" targetFoliageState="-1"/>
    <fruit name="BARLEY" densityReductionPercent="3" targetFoliageState="-1"/>
    <fruit name="CANOLA" densityReductionPercent="3" targetFoliageState="-1"/>
    <fruit name="OAT" densityReductionPercent="3" targetFoliageState="-1"/>
    <fruit name="MAIZE" densityReductionPercent="3" targetFoliageState="-1"/>
    <fruit name="SUNFLOWER" densityReductionPercent="3" targetFoliageState="-1"/>
    <fruit name="SOYBEAN" densityReductionPercent="3" targetFoliageState="-1"/>
    <fruit name="POTATO" densityReductionPercent="3" targetFoliageState="-1"/>
    <fruit name="RICE" densityReductionPercent="3" targetFoliageState="-1"/>
    <fruit name="RICELONGGRAIN" densityReductionPercent="3" targetFoliageState="-1"/>
    <fruit name="SUGARBEET" densityReductionPercent="3" targetFoliageState="-1"/>
    <fruit name="SUGARCANE" densityReductionPercent="3" targetFoliageState="-1"/>
    <fruit name="COTTON" densityReductionPercent="3" targetFoliageState="-1"/>
    <fruit name="SORGHUM" densityReductionPercent="3" targetFoliageState="-1"/>
    <fruit name="GRAPE" densityReductionPercent="3" targetFoliageState="-1"/>
    <fruit name="OLIVE" densityReductionPercent="3" targetFoliageState="-1"/>
    <fruit name="POPLAR" densityReductionPercent="3" targetFoliageState="-1"/>
    <fruit name="BEETROOT" densityReductionPercent="3" targetFoliageState="-1"/>
    <fruit name="CARROT" densityReductionPercent="3" targetFoliageState="-1"/>
    <fruit name="PARSNIP" densityReductionPercent="3" targetFoliageState="-1"/>
